#!/bin/sh
set -eu

if git grep -n -I -E '(^|/)(home|Users)/[^/ ]+|anonymous-contributor|local-user||slmails\.com|file:///|BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY' -- ':!AGENTS.md' ':!GEMINI.md' ':!.githooks/**' ':!.github/workflows/privacy-check.yml' >/tmp/database-privacy-match; then
  echo "Privacy check failed; personal paths, handles, emails, or private keys were found:" >&2
  cat /tmp/database-privacy-match >&2
  rm -f /tmp/database-privacy-match
  exit 1
fi
rm -f /tmp/database-privacy-match
