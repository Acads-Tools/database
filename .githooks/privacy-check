#!/bin/sh
set -eu

if git grep -n -I -E '(^|/)(home|Users)/[^/ ]+|ractopen|ryme|197402134|slmails\.com|file:///|BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY' -- . ':(exclude)AGENTS.md' ':(exclude)GEMINI.md' ':(exclude).githooks/**' ':(exclude).github/workflows/privacy-check.yml' >/tmp/database-privacy-match; then
  echo "Privacy check failed; personal paths, handles, emails, or private keys were found:" >&2
  cat /tmp/database-privacy-match >&2
  rm -f /tmp/database-privacy-match
  exit 1
fi
rm -f /tmp/database-privacy-match
