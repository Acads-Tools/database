#!/bin/sh
set -eu

files=$(git ls-files | grep -Ev '(^|/)(AGENTS|GEMINI)\.md$|^\.githooks/|^\.github/workflows/privacy-check\.yml$' || true)
if [ -n "$files" ] && printf '%s\n' "$files" | xargs grep -n -I -E '(^|/)(home|Users)/[^/ ]+|ractopen|ryme|197402134|slmails\.com|file:///|BEGIN (RSA|OPENSSH|EC|PGP) PRIVATE KEY' >/tmp/database-privacy-match; then
  echo "Privacy check failed; personal paths, handles, emails, or private keys were found:" >&2
  cat /tmp/database-privacy-match >&2
  rm -f /tmp/database-privacy-match
  exit 1
fi
rm -f /tmp/database-privacy-match
